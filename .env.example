# CloudCode Environment Configuration

# Security
SECRET_KEY=cloudcode-super-secret-key-change-in-production-2026-secure-jwt
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# For SQLite local fallback:
DATABASE_URL=sqlite+aiosqlite:///./cloudcode.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://cloudcode_user:cloudcode_secure_pass_2026@localhost:5432/cloudcode

# Redis / Ephemeral State
# REDIS_URL=redis://localhost:6379/0

# Execution limits
EXECUTION_TIMEOUT_SECONDS=15
MAX_EXECUTION_MEMORY_MB=128
MAX_OUTPUT_SIZE_BYTES=65536

# Local storage path
STORAGE_DIR=./cloudcode_storage

# Docker sandbox toggle
USE_DOCKER_SANDBOX=false
